#!/usr/bin/env bash
# =============================================================================
#  Hook 0100 — VirtuaOS system branding
#  Sets OS identity, login messages, and hostname.
# =============================================================================
set -euo pipefail

VIRTUAOS_VERSION="1.0.2-BETA"

echo "[VirtuaOS] Applying system branding…"

# ── /etc/os-release ──────────────────────────────────────────────────────────
cat > /etc/os-release <<EOF
PRETTY_NAME="VirtuaOS ${VIRTUAOS_VERSION} (Debian 13 Trixie)"
NAME="VirtuaOS"
VERSION="${VIRTUAOS_VERSION}"
VERSION_ID="${VIRTUAOS_VERSION}"
VERSION_CODENAME="trixie"
ID="virtuaos"
ID_LIKE="debian"
HOME_URL="https://auxinux.io"
SUPPORT_URL="https://auxinux.io/support"
BUG_REPORT_URL="https://github.com/auxinux/virtuaos/issues"
DEBIAN_CODENAME="trixie"
BUILD_ID="$(date -u +%Y%m%d)"
EOF

printf '%s\n' "${VIRTUAOS_VERSION%%-*}" > /etc/virtuaos-version
chmod 0644 /etc/virtuaos-version

# Keep Debian variant for compatibility (point release this ISO is based on)
cat > /etc/debian_version <<EOF
13.6
EOF

# ── Hostname ─────────────────────────────────────────────────────────────────
echo "virtuaos" > /etc/hostname

cat > /etc/hosts <<'HOSTS'
127.0.0.1   localhost
127.0.1.1   virtuaos.local virtuaos
::1         localhost ip6-localhost ip6-loopback
ff02::1     ip6-allnodes
ff02::2     ip6-allrouters
HOSTS

# ── /etc/issue (shown before login prompt) ───────────────────────────────────
cat > /etc/issue <<'ISSUE'

  ██╗   ██╗██╗██████╗ ████████╗██╗   ██╗ █████╗  ██████╗ ███████╗
  ██║   ██║██║██╔══██╗╚══██╔══╝██║   ██║██╔══██╗██╔═══██╗██╔════╝
  ██║   ██║██║██████╔╝   ██║   ██║   ██║███████║██║   ██║███████╗
  ╚██╗ ██╔╝██║██╔══██╗   ██║   ██║   ██║██╔══██║██║   ██║╚════██║
   ╚████╔╝ ██║██║  ██║   ██║   ╚██████╔╝██║  ██║╚██████╔╝███████║
    ╚═══╝  ╚═╝╚═╝  ╚═╝   ╚═╝    ╚═════╝ ╚═╝  ╚═╝ ╚═════╝ ╚══════╝

  Version 1.0.2-BETA  •  Powered by Debian 13 Trixie  •  x86_64

ISSUE

# ── /etc/issue.net (shown for SSH) ───────────────────────────────────────────
cat > /etc/issue.net <<'ISSUENET'
VirtuaOS 1.0.2-BETA — Powered by Debian 13 Trixie
Web Panel: https://<IP>:8441
ISSUENET

# ── /etc/motd (shown after login) ────────────────────────────────────────────
# Dynamic MOTD is handled by /etc/profile.d/virtuaos.sh
# Static motd is minimal
cat > /etc/motd <<'MOTD'
MOTD

echo "[VirtuaOS] Branding applied."
